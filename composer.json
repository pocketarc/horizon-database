{
    "name": "pocketarc/horizon-database",
    "description": "Run Laravel Horizon on a relational database instead of Redis.",
    "keywords": ["laravel", "horizon", "queue", "database"],
    "homepage": "https://github.com/pocketarc/horizon-database",
    "license": "MIT",
    "authors": [
        {
            "name": "Bruno Moreira",
            "email": "bruno.moreira@solmyr.com"
        },
        {
            "name": "Steve Bauman",
            "homepage": "https://github.com/laravel/horizon/pull/1762",
            "role": "Original author of the database driver implementation"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/horizon": "^5.46",
        "nesbot/carbon": "^2.17|^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "PocketArc\\HorizonDatabase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PocketArc\\HorizonDatabase\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PocketArc\\HorizonDatabase\\HorizonDatabaseServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
